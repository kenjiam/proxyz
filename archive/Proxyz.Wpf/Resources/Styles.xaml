<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <sys:Double x:Key="BodyFontSize">15</sys:Double>
 <sys:Double x:Key="HeadingFontSize">27</sys:Double>
 <sys:Double x:Key="SectionFontSize">20</sys:Double>
 <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}" />
  <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
  <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style TargetType="Button">
  <Setter Property="Padding" Value="15,9" />
  <Setter Property="Margin" Value="0,0,8,8" />
  <Setter Property="MinHeight" Value="38" />
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="9,7" />
  <Setter Property="Margin" Value="0,0,0,12" />
  <Setter Property="MinHeight" Value="36" />
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Padding" Value="9,7" />
  <Setter Property="Margin" Value="0,0,0,12" />
  <Setter Property="MinHeight" Value="36" />
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Margin" Value="0,7,0,11" />
  <Setter Property="MinHeight" Value="30" />
 </Style>
 <Style TargetType="Label">
  <Setter Property="Padding" Value="0,0,0,6" />
 </Style>
 <Style TargetType="GroupBox">
  <Setter Property="Padding" Value="16" />
  <Setter Property="Margin" Value="0,0,0,16" />
 </Style>
 <Style x:Key="Heading" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Margin" Value="0,0,0,8" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Margin" Value="0,0,0,8" />
 </Style>
 <Style x:Key="Card" TargetType="Border">
  <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="8" />
  <Setter Property="Padding" Value="18" />
  <Setter Property="Margin" Value="0,0,0,16" />
 </Style>
 <Style x:Key="ReadOnlyValue" TargetType="TextBox">
  <Setter Property="IsReadOnly" Value="True" />
  <Setter Property="TextWrapping" Value="Wrap" />
  <Setter Property="AcceptsReturn" Value="True" />
  <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  <Setter Property="MaxHeight" Value="160" />
 </Style>
</ResourceDictionary>
