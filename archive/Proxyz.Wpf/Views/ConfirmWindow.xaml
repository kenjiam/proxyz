<Window x:Class="Proxyz.App.Views.ConfirmWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="変更内容の確認 — Proxyz" Width="720" Height="660" MinWidth="430" MinHeight="340" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="22">
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button x:Name="CancelButton" Content="キャンセル(_C)" IsCancel="True" />
   <Button x:Name="ConfirmButton" Content="変更する(_A)" Click="Confirm_Click" AutomationProperties.AutomationId="ConfirmAction" />
  </WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="Heading" Style="{StaticResource SectionHeading}" />
    <TextBlock x:Name="Description" Margin="0,0,0,18" />
    <Label Target="{Binding ElementName=CurrentBox}" Content="現在の Windows 設定" />
    <TextBox x:Name="CurrentBox" Style="{StaticResource ReadOnlyValue}" AutomationProperties.Name="現在の Windows 設定" />
    <Label x:Name="TargetLabel" Target="{Binding ElementName=TargetBox}" Content="変更後の設定" />
    <TextBox x:Name="TargetBox" Style="{StaticResource ReadOnlyValue}" AutomationProperties.Name="変更後の設定" />
    <TextBlock Text="設定の適用と、インターネットへの接続成功は別です。組織から指定された設定か確認してください。" Margin="0,8,0,0" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
