<Window x:Class="Proxyz.App.Views.ProfileEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="プロファイル — Proxyz" Width="760" Height="760" MinWidth="430" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="22">
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="キャンセル(_C)" IsCancel="True" />
   <Button Content="保存(_S)" Click="Save_Click" AutomationProperties.AutomationId="SaveProfile" />
  </WrapPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}">
   <TextBlock x:Name="ErrorSummary" Text="{Binding Error}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="入力内容のエラー" />
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="プロキシプロファイル" Style="{StaticResource Heading}" />
    <TextBlock Text="保存するだけでは Windows の設定は変わりません。切替はホーム画面から行います。" Margin="0,0,0,18" />
    <Label x:Name="NameLabel" Target="{Binding ElementName=NameBox}" Content="名前(_N)" />
    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" AutomationProperties.AutomationId="ProfileName" />
    <Label x:Name="ModeLabel" Target="{Binding ElementName=ModeBox}" Content="接続方法(_M)" />
    <ComboBox x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
    <GroupBox Header="手動プロキシ" Visibility="{Binding ShowSimple, Converter={StaticResource BooleanVisibility}}">
     <StackPanel>
      <Label x:Name="HostLabel" Target="{Binding ElementName=HostBox}" Content="サーバーのアドレス(_H)" />
      <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=HostLabel}" AutomationProperties.HelpText="例 proxy.example.com。URL の http:// は付けません。IPv6 も指定できます。" />
      <TextBlock Text="例：proxy.example.com。http:// やパスワードは付けません。" Margin="0,0,0,12" />
      <Label x:Name="PortLabel" Target="{Binding ElementName=PortBox}" Content="ポート番号(_P)" />
      <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}" AutomationProperties.HelpText="1 から 65535 の整数。例 8080。" />
     </StackPanel>
    </GroupBox>
    <GroupBox Header="詳細設定" Visibility="{Binding ShowAdvanced, Converter={StaticResource BooleanVisibility}}">
     <StackPanel>
      <TextBlock Text="組織から複数方式の併用を指示された場合に使用します。方式の優先順位や実際の動作は Windows・利用アプリに依存します。" Margin="0,0,0,8" />
      <CheckBox Content="自動検出（WPAD）を使う(_A)" IsChecked="{Binding AutoDetectEnabled}" />
      <CheckBox Content="設定スクリプト（PAC）を使う(_U)" IsChecked="{Binding ScriptEnabled}" />
      <CheckBox Content="手動プロキシを使う(_X)" IsChecked="{Binding ManualEnabled}" />
      <Label x:Name="RawLabel" Target="{Binding ElementName=RawBox}" Content="サーバーの詳細指定(_V)" />
      <TextBox x:Name="RawBox" Text="{Binding RawServers, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.LabeledBy="{Binding ElementName=RawLabel}" />
      <TextBlock Text="例：http=proxy.example.com:8080;https=secure-proxy.example.com:8080。接続先の方式ごとの指定であり、プロキシとの暗号化を保証する設定ではありません。" />
      <CheckBox Content="Windows の直接接続フラグを有効にする(_D)" IsChecked="{Binding DirectEnabled}" />
      <TextBlock Text="このフラグだけで、プロキシ障害時に必ず直接接続するとは限りません。組織の指示と現在の設定を確認してください。" />
     </StackPanel>
    </GroupBox>
    <StackPanel Visibility="{Binding ShowPac, Converter={StaticResource BooleanVisibility}}">
     <Label x:Name="PacLabel" Target="{Binding ElementName=PacBox}" Content="設定スクリプトの URL(_L)" />
     <TextBox x:Name="PacBox" Text="{Binding PacUrl, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.LabeledBy="{Binding ElementName=PacLabel}" AutomationProperties.HelpText="組織から指定された http または https の URL。Proxyz 自身はダウンロード・実行しません。" />
     <TextBlock Text="信頼する組織から指定された URL を入力してください。Proxyz 自身はスクリプトを取得・実行しません。" Margin="0,0,0,14" />
    </StackPanel>
    <GroupBox Header="プロキシを使わない宛先" Visibility="{Binding ShowBypass, Converter={StaticResource BooleanVisibility}}">
     <StackPanel>
      <Label x:Name="BypassLabel" Target="{Binding ElementName=BypassBox}" Content="除外するホスト(_B)" />
      <TextBox x:Name="BypassBox" Text="{Binding Bypass, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="95" MaxHeight="210" VerticalScrollBarVisibility="Auto" AutomationProperties.LabeledBy="{Binding ElementName=BypassLabel}" AutomationProperties.HelpText="1行に1つ、またはセミコロン区切り。例 *.example.com。" />
      <TextBlock Text="1行に1つ、または ; 区切りで入力。例：*.example.com。除外構文の解釈は利用アプリによって異なります。" />
      <CheckBox Content="ドットのないローカル名を除外する（&lt;local&gt;）(_O)" IsChecked="{Binding BypassLocal}" />
     </StackPanel>
    </GroupBox>
    <Label x:Name="NoteLabel" Target="{Binding ElementName=NoteBox}" Content="メモ（任意）(_E)" />
    <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" MinHeight="74" AutomationProperties.LabeledBy="{Binding ElementName=NoteLabel}" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
