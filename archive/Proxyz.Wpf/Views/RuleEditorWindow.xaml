<Window x:Class="Proxyz.App.Views.RuleEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="自動切替ルール — Proxyz" Width="760" Height="760" MinWidth="430" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="22">
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="キャンセル(_C)" IsCancel="True" />
   <Button Content="保存(_S)" Click="Save_Click" AutomationProperties.AutomationId="SaveRule" />
  </WrapPanel>
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}">
   <TextBlock x:Name="ErrorSummary" Text="{Binding Error}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="ルール入力のエラー" />
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="ネットワークと設定を結び付ける" Style="{StaticResource Heading}" />
    <TextBlock Text="複数の条件を指定した場合は、すべてに一致したときだけ適用します。設定を保存しても、自動切替を再開するまでは Windows を変更しません。" Margin="0,0,0,18" />
    <Label x:Name="NameLabel" Content="ルール名(_N)" Target="{Binding ElementName=NameBox}" />
    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />
    <Label x:Name="ProfileLabel" Content="適用するプロファイル(_P)" Target="{Binding ElementName=ProfileBox}" />
    <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.LabeledBy="{Binding ElementName=ProfileLabel}" />
    <Label x:Name="ModeLabel" Content="識別方法(_M)" Target="{Binding ElementName=ModeBox}" />
    <ComboBox x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
    <Label x:Name="NetworkLabel" Content="接続中のネットワークから取り込む(_W)" Target="{Binding ElementName=NetworkBox}" />
    <ComboBox x:Name="NetworkBox" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" DisplayMemberPath="Display" AutomationProperties.LabeledBy="{Binding ElementName=NetworkLabel}" />
    <StackPanel Visibility="{Binding ShowNetwork, Converter={StaticResource BooleanVisibility}}">
     <Label x:Name="IdLabel" Content="Windows ネットワーク ID(_I)" Target="{Binding ElementName=IdBox}" />
     <TextBox x:Name="IdBox" Text="{Binding NetworkId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=IdLabel}" />
     <TextBlock Text="Windows が端末内で識別する ID です。ネットワークの再構築・リセット後に変わる場合は、取り込み直してください。" Margin="0,0,0,16" />
    </StackPanel>
    <StackPanel Visibility="{Binding ShowSsid, Converter={StaticResource BooleanVisibility}}">
     <Label x:Name="SsidLabel" Content="Wi-Fi の SSID(_F)" Target="{Binding ElementName=SsidBox}" />
     <TextBox x:Name="SsidBox" Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=SsidLabel}" />
     <CheckBox Content="SSID を16進数で入力する（通常は不要）(_X)" IsChecked="{Binding SsidIsHex}" />
     <TextBlock Text="SSID は大文字・小文字を区別して完全一致で判定します。同名 Wi-Fi や eduroam では場所を区別できません。SSID は信頼性の証明ではありません。" Margin="0,0,0,16" />
    </StackPanel>
    <CheckBox Content="このルールを有効にする(_E)" IsChecked="{Binding Enabled}" />
    <TextBlock Text="同時に異なるプロファイルのルールが一致した場合や、別の未登録ネットワークも接続されている場合は、勝手に選ばず現在の設定を維持します。" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
