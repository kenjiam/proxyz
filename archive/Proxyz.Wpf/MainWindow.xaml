<Window x:Class="Proxyz.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1040" Height="820" MinWidth="540" MinHeight="400"
 WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
 <DockPanel>
  <Menu DockPanel.Dock="Top" AutomationProperties.Name="メインメニュー">
   <MenuItem Header="ファイル(_F)">
    <MenuItem Header="Windows のプロキシ設定を開く(_W)" Command="{Binding OpenProxySettingsCommand}" />
    <MenuItem Header="データフォルダーを開く(_D)" Command="{Binding OpenDataCommand}" />
    <Separator />
    <MenuItem Header="終了（Windows 設定は維持）(_X)…" Command="{Binding ExitCommand}" />
   </MenuItem>
   <MenuItem Header="操作(_O)">
    <MenuItem Header="状態を更新(_R)" InputGestureText="F5" Command="{Binding RefreshCommand}" />
    <MenuItem Header="{Binding ToggleText}" Command="{Binding ToggleAutomationCommand}" />
    <MenuItem Header="直前の設定に戻す(_U)…" Command="{Binding RestoreCommand}" />
   </MenuItem>
   <MenuItem Header="ヘルプ(_H)">
    <MenuItem Header="使い方とキーボード操作(_G)" Command="{Binding HelpCommand}" />
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Padding="24,18,24,12">
   <StackPanel>
    <TextBlock Text="Proxyz" Style="{StaticResource Heading}" />
    <TextBlock Text="ネットワークに合わせて、Windows のプロキシを切り替える。" />
    <TextBlock Text="デモモード — Windows の設定は変更しません" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BooleanVisibility}}" />
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
   <StackPanel>
    <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="StatusText" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="操作結果" AutomationProperties.AutomationId="OperationStatus" />
    </ScrollViewer>
   </StackPanel>
  </Border>
  <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTab}" Margin="20,0,20,12" AutomationProperties.Name="画面" KeyboardNavigation.TabNavigation="Continue">
   <TabItem Header="ホーム" AutomationProperties.Name="ホーム">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,18,12,12">
     <StackPanel>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="{Binding AutomaticState}" Style="{StaticResource SectionHeading}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AutomationState" />
        <TextBlock Text="{Binding Reason}" Margin="0,0,0,14" />
        <WrapPanel>
         <Button Content="{Binding ToggleText}" Command="{Binding ToggleAutomationCommand}" />
         <Button Content="状態を更新(_R)" Command="{Binding RefreshCommand}" AutomationProperties.HelpText="F5 キーでも更新できます。" />
        </WrapPanel>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Visibility="{Binding HasPolicyNotice, Converter={StaticResource BooleanVisibility}}">
       <StackPanel>
        <TextBlock Text="管理設定について" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="{Binding PolicyNotice}" AutomationProperties.LiveSetting="Polite" />
       </StackPanel>
      </Border>
      <GroupBox Header="現在の Windows 設定">
       <StackPanel>
        <TextBlock Text="{Binding CurrentProfileName}" Style="{StaticResource SectionHeading}" />
        <TextBox Text="{Binding CurrentDescription, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" AutomationProperties.Name="現在のプロキシ設定の詳細。選択してコピーできます。" />
        <TextBlock Text="ここでの適用対象は、ユーザーの通常の Windows プロキシ設定です。WinHTTP・VPN 専用設定・アプリ固有設定は変更しません。" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="手動で切り替える">
       <StackPanel>
        <Label x:Name="ApplyLabel" Target="{Binding ElementName=ProfileChoice}" Content="プロファイル(_P)" />
        <ComboBox x:Name="ProfileChoice" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.LabeledBy="{Binding ElementName=ApplyLabel}" AutomationProperties.AutomationId="ProfileChoice" />
        <WrapPanel>
         <Button Content="選択した設定に切り替える(_M)…" Command="{Binding ApplyCommand}" />
         <Button Content="直接接続にする(_D)…" Command="{Binding DirectCommand}" />
         <Button Content="現在の設定を保存(_S)…" Command="{Binding CaptureCommand}" />
        </WrapPanel>
        <TextBlock Text="手動切替後は自動切替を一時停止します。内容を確認してから再開してください。" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="接続中のネットワーク">
       <StackPanel>
        <TextBlock Text="{Binding NetworkCountText}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Networks}" AutomationProperties.Name="接続中のネットワーク一覧">
         <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Display}" Margin="0,0,0,7" /></DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding NetworkNotice}" Margin="0,10,0,0" Visibility="{Binding HasNetworkNotice, Converter={StaticResource BooleanVisibility}}" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="元に戻す">
       <StackPanel>
        <TextBlock Text="{Binding BackupDescription}" Margin="0,0,0,12" />
        <WrapPanel>
         <Button Content="直前の設定に戻す(_U)…" Command="{Binding RestoreCommand}" />
         <Button Content="初回変更前に戻す(_B)…" Command="{Binding RestoreOriginalCommand}" />
        </WrapPanel>
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="プロファイル" AutomationProperties.Name="プロファイル">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,18,12,12">
     <StackPanel>
      <TextBlock Text="場所ごとの設定を保存する" Style="{StaticResource SectionHeading}" />
      <TextBlock Text="大学・会社・自宅など、Windows に適用する設定をまとめて管理します。編集後は自動切替を一時停止します。" Margin="0,0,0,16" />
      <WrapPanel>
       <Button Content="新しく作る(_N)…" Command="{Binding AddProfileCommand}" />
       <Button Content="現在の設定を取り込む(_C)…" Command="{Binding CaptureCommand}" />
      </WrapPanel>
      <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="150" MaxHeight="440" Margin="0,8,0,16" AutomationProperties.Name="保存済みプロファイル" AutomationProperties.AutomationId="ProfileList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding Display}" /></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Settings.Summary}" Margin="0,5,0,0" /><TextBlock Text="{Binding Note}" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel>
       <Button Content="編集(_E)…" Command="{Binding EditProfileCommand}" />
       <Button Content="削除(_D)…" Command="{Binding DeleteProfileCommand}" />
       <Button Content="この設定に切り替える(_M)…" Command="{Binding ApplyCommand}" />
      </WrapPanel>
      <TextBlock Text="プロファイルを削除しても、Windows に適用済みの設定はそのままです。ルールで使用中のプロファイルは削除できません。" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="自動切替ルール" AutomationProperties.Name="自動切替ルール">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,18,12,12">
     <StackPanel>
      <TextBlock Text="ネットワークとプロファイルを結び付ける" Style="{StaticResource SectionHeading}" />
      <TextBlock Text="Wi-Fi は SSID または Windows のネットワーク ID、有線LAN はネットワーク ID で判定します。SSID が同じでも同じ組織とは限りません。" Margin="0,0,0,16" />
      <WrapPanel><Button Content="ルールを作る(_N)…" Command="{Binding AddRuleCommand}" /></WrapPanel>
      <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MinHeight="150" MaxHeight="440" Margin="0,8,0,16" AutomationProperties.Name="自動切替ルール一覧" AutomationProperties.AutomationId="RuleList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding Display}" /></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Display}" FontWeight="SemiBold" /><TextBlock Text="{Binding Condition}" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel>
       <Button Content="編集(_E)…" Command="{Binding EditRuleCommand}" />
       <Button Content="削除(_D)…" Command="{Binding DeleteRuleCommand}" />
      </WrapPanel>
      <TextBlock Text="競合するルールの優先順位は自動では決めません。同時接続したネットワークが別の設定を要求する場合は、現在の設定を維持して理由を表示します。" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="設定" AutomationProperties.Name="設定">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,18,12,12">
     <StackPanel>
      <TextBlock Text="自動切替と表示の設定" Style="{StaticResource SectionHeading}" />
      <GroupBox Header="ネットワークの識別">
       <StackPanel>
        <CheckBox Content="Wi-Fi の SSID を読み取る(_W)" IsChecked="{Binding ObserveWifi}" AutomationProperties.HelpText="Windows の位置情報の許可が必要な場合があります。近隣ネットワークのスキャンは行いません。" />
        <TextBlock Text="Windows の位置情報の許可が必要な場合があります。拒否した場合も、手動切替や Windows ネットワーク ID のルールは利用できます。" />
        <Button Content="Windows の位置情報設定を開く(_L)" Command="{Binding OpenLocationSettingsCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" />
        <CheckBox Content="VPN・トンネルを検出したら自動変更を控える(_V)" IsChecked="{Binding PauseOnVpn}" />
        <TextBlock Text="VPN 検出は接続の種類と既知のアダプター名による補助判定です。すべての VPN を検出できるとは限りません。VPN 固有の設定は変更しません。" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="未登録のネットワーク">
       <StackPanel>
        <Label x:Name="UnknownLabel" Target="{Binding ElementName=UnknownChoice}" Content="どのルールにも一致しない場合(_U)" />
        <ComboBox x:Name="UnknownChoice" ItemsSource="{Binding UnknownOptions}" SelectedIndex="{Binding UnknownActionIndex}" AutomationProperties.LabeledBy="{Binding ElementName=UnknownLabel}" />
        <TextBlock Text="『直接接続』を選んでも、情報を取得できない場合・接続が競合する場合・未接続時は変更しません。" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="ログイン時の起動">
       <StackPanel>
        <CheckBox Content="Windows にログインしたらトレイに起動する(_T)" IsChecked="{Binding StartupEnabled}" IsEnabled="{Binding IsReal}" />
        <TextBlock Text="このユーザーだけに登録します。Windows のスタートアップ設定で無効にされている場合は、そちらも確認してください。配布フォルダーを移動したら再登録が必要です。" />
       </StackPanel>
      </GroupBox>
      <GroupBox Header="文字と操作">
       <StackPanel>
        <Label x:Name="ScaleLabel" Target="{Binding ElementName=ScaleSlider}" Content="{Binding ScaleLabel}" />
        <Slider x:Name="ScaleSlider" Value="{Binding UiScale}" Minimum="1" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="0.5" TickPlacement="BottomRight" Margin="0,8,0,18" AutomationProperties.LabeledBy="{Binding ElementName=ScaleLabel}" AutomationProperties.HelpText="左右の矢印キーで倍率を変更できます。保存後に反映します。" />
        <TextBlock Text="Windows の表示倍率・コントラストテーマと組み合わせて使用できます。すべての操作はキーボードで行えます。トレイを使わず、スタートメニューや実行ファイルから画面を再表示できます。" />
       </StackPanel>
      </GroupBox>
      <WrapPanel><Button Content="設定を保存(_S)" Command="{Binding SaveSettingsCommand}" AutomationProperties.AutomationId="SavePreferences" /></WrapPanel>
      <TextBlock Text="保存後は自動切替を一時停止します。ホームで内容を確認して再開してください。" Margin="0,0,0,18" />
      <GroupBox Header="データと対応範囲">
       <StackPanel>
        <TextBlock Text="端末内だけに保存します。アカウント登録・クラウド同期・テレメトリーはありません。プロファイルと復元記録には組織内のアドレスが含まれるため、共有時は注意してください。" Margin="0,0,0,12" />
        <WrapPanel>
         <Button Content="データフォルダーを開く(_D)" Command="{Binding OpenDataCommand}" />
         <Button Content="使い方(_G)" Command="{Binding HelpCommand}" />
        </WrapPanel>
        <TextBlock Text="WinHTTP・Windows サービス・VPN 専用設定・Git/npm・DNS・証明書は、この版では管理しません。" />
       </StackPanel>
      </GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
